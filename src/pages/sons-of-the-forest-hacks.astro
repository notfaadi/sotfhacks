---
import BaseLayout from '../layouts/BaseLayout.astro'
import { GameProductPage } from '../views/GameProductPage'
import { SEO, SITE_URL } from '../data/site'
import { productDetailJsonLd } from '../lib/seo'
import { getGame } from '../data/games'

const game = getGame('sons-of-the-forest')
const jsonLdExtra = [
  productDetailJsonLd(game?.status ?? 'Updating'),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Sons of the Forest Hacks',
        item: `${SITE_URL}/sons-of-the-forest-hacks`,
      },
    ],
  },
]
---

<BaseLayout seo={SEO.product} jsonLdExtra={jsonLdExtra}>
  <GameProductPage client:idle guideSlug="sons-of-the-forest-hacks" />
</BaseLayout>
